#!/usr/bin/env python3
from __future__ import annotations

import argparse
import difflib
import json
import os
import shutil
import subprocess
import sys
from pathlib import Path


MILESTONE = "V5-S15B-R2-CODEX-RUNTIME-EVENT-ATTRIBUTED-WORKLOOP"
TASK_MILESTONE = "V5-S15C-CODEX-BOUNDED-TASK-EXECUTION"
TASK_ID = "s15c-synthetic-bugfix"
MARKER_NAME = "adapter identity marker"
MARKER_VALUE = "PAI_" + "CODEX_" + "PEER_" + "BETA_" + "ADAPTER"
ADAPTER_STATUS = "peer-beta"
UPSTREAM_ADAPTER = "claude"
ADAPTER_RELATIVE = Path("adapters") / "codex"
RUN_RELATIVE = ADAPTER_RELATIVE / "runs" / "s15b-r2"
RUNTIME_PROOF_NAME = "runtime-proof.json"
WORKLOOP_NAME = "workloop-once.json"
RUNTIME_EVENTS_NAME = "runtime-events.jsonl"
WORKLOOP_EVENTS_NAME = "workloop-events.jsonl"
RUNTIME_VALIDATION_NAME = "runtime-validation.json"
TASK_RUN_RELATIVE = ADAPTER_RELATIVE / "runs" / "s15c"
TASK_WORKSPACE_NAME = "workspace"
TASK_RESULT_NAME = "task-result.json"
TASK_EVENTS_NAME = "task-events.jsonl"
TASK_DIFF_NAME = "task.diff"
TASK_VALIDATION_NAME = "task-validation.json"
TASK_STATE_NAME = "task-run-state.json"
PROVIDER_MILESTONE = "V5-S15D-PAI-RUNTIME-RUNNER-CODEX"
PROVIDER_RUN_ID = "s15d-codex-synthetic-bugfix"
PROVIDER_RUN_RELATIVE = Path("runs") / "s15d" / "codex-synthetic-bugfix"
PROVIDER_TASK_CARD_RELATIVE = Path("runtime-tasks") / "s15d-codex-synthetic-bugfix.json"
PROVIDER_FIXTURE_RELATIVE = Path("runtime-task-fixtures") / "s15d_bugfix"
PROVIDER_RESULT_NAME = "run-result.json"
PROVIDER_EVENTS_NAME = "runtime-events.jsonl"
PROVIDER_DIFF_NAME = "task.diff"
PROVIDER_STATE_NAME = "run-state.json"


class LauncherError(ValueError):
    pass


def _resolve_pai_dir(value: str | Path) -> Path:
    path = Path(value)
    if str(value) == "":
        raise LauncherError("--pai-dir must not be empty")
    if any(part == ".." for part in path.parts):
        raise LauncherError("--pai-dir must not contain path traversal")
    resolved = path.resolve(strict=True)
    if not resolved.is_dir():
        raise LauncherError("--pai-dir must be a directory")
    return resolved


def _adapter_dir(pai_dir: Path) -> Path:
    return pai_dir / ADAPTER_RELATIVE


def _run_dir(pai_dir: Path) -> Path:
    return pai_dir / RUN_RELATIVE


def _is_within(root: Path, candidate: Path) -> bool:
    try:
        candidate.relative_to(root)
    except ValueError:
        return False
    return True


def _safe_output_path(pai_dir: Path, output: str | Path, expected_name: str) -> Path:
    if str(output) == "":
        raise LauncherError("--output must not be empty")
    output_path = Path(output)
    if any(part == ".." for part in output_path.parts):
        raise LauncherError("--output must not contain path traversal")
    resolved = output_path.resolve(strict=False)
    run_dir = _run_dir(pai_dir).resolve(strict=False)
    if not _is_within(run_dir, resolved):
        raise LauncherError("runtime output must stay under adapters/codex/runs/s15b-r2")
    if resolved.name != expected_name:
        raise LauncherError(f"runtime output must be named {expected_name}")
    if output_path.exists() and not output_path.is_file():
        raise LauncherError("runtime output target is not a file")
    if output_path.is_symlink():
        raise LauncherError("runtime output target is a symlink")
    return output_path


def _safe_existing_path(path_value: str | Path, label: str) -> Path:
    if str(path_value) == "":
        raise LauncherError(f"{label} must not be empty")
    path = Path(path_value)
    if any(part == ".." for part in path.parts):
        raise LauncherError(f"{label} must not contain path traversal")
    resolved = path.resolve(strict=True)
    if path.is_symlink():
        raise LauncherError(f"{label} must not be a symlink")
    return resolved


def _safe_run_input_path(pai_dir: Path, path_value: str | Path, expected_name: str, label: str) -> Path:
    path = _safe_existing_path(path_value, label)
    run_dir = _run_dir(pai_dir).resolve(strict=False)
    if not _is_within(run_dir, path):
        raise LauncherError(f"{label} must stay under adapters/codex/runs/s15b-r2")
    if path.name != expected_name:
        raise LauncherError(f"{label} must be named {expected_name}")
    if not path.is_file():
        raise LauncherError(f"{label} must be a file")
    return path


def _read_json(path: Path, label: str) -> dict[str, object]:
    if not path.is_file():
        raise LauncherError(f"{label} is missing: {path}")
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise LauncherError(f"{label} is not valid JSON") from exc
    if not isinstance(data, dict):
        raise LauncherError(f"{label} must be a JSON object")
    return data


def doctor(pai_dir: Path) -> dict[str, object]:
    router = pai_dir / "AGENTS.md"
    adapter_dir = _adapter_dir(pai_dir)
    manifest_path = adapter_dir / "adapter-manifest.json"
    launcher_path = adapter_dir / "bin" / "pai-codex"
    runtime_schema_path = adapter_dir / "runtime-proof.schema.json"
    workloop_schema_path = adapter_dir / "workloop-once.schema.json"
    validation_schema_path = adapter_dir / "runtime-validation.schema.json"
    task_card_schema_path = adapter_dir / "task-card.schema.json"
    task_result_schema_path = adapter_dir / "task-result.schema.json"
    task_validation_schema_path = adapter_dir / "task-validation.schema.json"
    task_card_path = adapter_dir / "tasks" / "s15c-synthetic-bugfix.json"

    if not router.is_file():
        raise LauncherError("PAI_DIR/AGENTS.md is missing")
    router_text = router.read_text(encoding="utf-8")
    if MARKER_VALUE not in router_text:
        raise LauncherError(f"PAI_DIR/AGENTS.md is missing {MARKER_NAME}")
    for forbidden in (
        "Codex is replacement-grade",
        "Codex replaces Claude",
        "Codex may write Memory",
        "Codex may write ISA",
        "Codex may probe Pulse",
    ):
        if forbidden in router_text:
            raise LauncherError(f"router contains forbidden claim: {forbidden}")

    manifest = _read_json(manifest_path, "adapter manifest")
    if manifest.get("adapter_status") != ADAPTER_STATUS:
        raise LauncherError("manifest does not preserve adapter_status=peer-beta")
    if manifest.get("upstream_adapter") != UPSTREAM_ADAPTER:
        raise LauncherError("manifest does not preserve upstream_adapter=claude")
    if manifest.get("adapter_status") == "replacement-grade":
        raise LauncherError("manifest claims replacement-grade status")

    memory_policy = manifest.get("memory_policy")
    isa_policy = manifest.get("isa_policy")
    pulse_policy = manifest.get("pulse_policy")
    if not isinstance(memory_policy, dict) or memory_policy.get("status") != "writes-not-approved":
        raise LauncherError("Memory write policy is not disabled")
    if not isinstance(isa_policy, dict) or isa_policy.get("status") != "writes-not-approved":
        raise LauncherError("ISA write policy is not disabled")
    if not isinstance(pulse_policy, dict) or pulse_policy.get("bridge_status") != "not-approved":
        raise LauncherError("Pulse bridge is not absent")

    for path, label in (
        (launcher_path, "runtime launcher"),
        (runtime_schema_path, "runtime proof schema"),
        (workloop_schema_path, "workloop schema"),
        (validation_schema_path, "runtime validation schema"),
        (task_card_schema_path, "task card schema"),
        (task_result_schema_path, "task result schema"),
        (task_validation_schema_path, "task validation schema"),
        (task_card_path, "S15C task card"),
    ):
        if not path.is_file():
            raise LauncherError(f"{label} is missing: {path}")

    return {
        "ok": True,
        "pai_dir": str(pai_dir),
        "adapter_status": ADAPTER_STATUS,
        "upstream_adapter": UPSTREAM_ADAPTER,
        "adapter_identity_marker_observed": True,
    }


def _proof_prompt(pai_dir: Path) -> str:
    return (
        "You are running the contained PAI Codex adapter runtime proof. "
        "Work only from the current PAI_DIR and do not modify files or run shell commands. "
        "Use the active AGENTS.md instructions Codex loaded from PAI_DIR and report the adapter identity marker exactly as written there. "
        "Confirm Codex remains peer beta and the upstream adapter remains claude. "
        "Return only JSON matching the provided schema. "
        f"Use milestone_name {MILESTONE!r}, pai_dir {str(pai_dir)!r}, "
        "agents_router_observed true, memory_write_performed false, "
        "isa_write_performed false, pulse_probe_performed false, "
        "localhost_31337_called false, runtime_surface_created false. "
        "Use evidence_classification values including 'runtime proof evidence', "
        "'non-canonical evidence', and 'not replacement readiness'. "
        "Use known_limits values that do not quote endpoint strings or raw file contents. "
        "Do not include any host-and-port endpoint string. "
        "Do not include raw Memory, ISA, Pulse, Claude product, Codex product, backup, or personal file contents."
    )


def _workloop_prompt(pai_dir: Path) -> str:
    return (
        "You are running one contained PAI Codex adapter work-loop pass. "
        "Work only from the current PAI_DIR and do not modify files or run shell commands. "
        "Use the active AGENTS.md instructions Codex loaded from PAI_DIR and report the adapter identity marker exactly as written there. "
        "Produce one bounded adapter decision artifact with workloop_kind "
        "'bounded-read-only-adapter-workloop'. "
        "Select a concrete next adapter-building action, not a documentation-only action, "
        "and mark requires_architect_goal_card true. "
        f"Use milestone_name {MILESTONE!r}, pai_dir {str(pai_dir)!r}, "
        "adapter_status peer-beta, upstream_adapter claude, memory_write_performed false, "
        "isa_write_performed false, pulse_probe_performed false, localhost_31337_called false, "
        "runtime_surface_created false. "
        "Use evidence_classification values including 'runtime workloop evidence', "
        "'non-canonical evidence', and 'not replacement readiness'. "
        "Use known_limits values that do not quote endpoint strings or raw file contents. "
        "Return only JSON matching the provided schema. "
        "Do not include any host-and-port endpoint string. "
        "Do not include raw Memory, ISA, Pulse, Claude product, Codex product, backup, or personal file contents."
    )


def _build_codex_exec_command(pai_dir: Path, schema_path: Path, output_path: Path, prompt: str) -> list[str]:
    return [
        "codex",
        "--ask-for-approval",
        "never",
        "exec",
        "--ephemeral",
        "--ignore-rules",
        "--json",
        "--sandbox",
        "read-only",
        "--cd",
        str(pai_dir),
        "--skip-git-repo-check",
        "--output-schema",
        str(schema_path),
        "-o",
        str(output_path),
        prompt,
    ]


def _run_codex_exec(
    pai_dir: Path,
    output: str | Path,
    events_output: str | Path,
    schema_name: str,
    output_name: str,
    events_name: str,
    prompt: str,
    dry_run: bool,
) -> dict[str, object]:
    doctor(pai_dir)
    output_path = _safe_output_path(pai_dir, output, output_name)
    events_path = _safe_output_path(pai_dir, events_output, events_name)
    schema_path = _adapter_dir(pai_dir) / schema_name
    if not schema_path.is_file():
        raise LauncherError(f"runtime schema is missing: {schema_path}")
    command = _build_codex_exec_command(pai_dir, schema_path, output_path, prompt)
    if dry_run:
        return {
            "dry_run": True,
            "command": command,
            "cwd": str(pai_dir),
            "output": str(output_path),
            "events_output": str(events_path),
            "schema": str(schema_path),
            "prompt": prompt,
        }

    output_path.parent.mkdir(parents=True, exist_ok=True)
    events_path.parent.mkdir(parents=True, exist_ok=True)
    with events_path.open("w", encoding="utf-8") as events_file:
        result = subprocess.run(
            command,
            cwd=pai_dir,
            stdin=subprocess.DEVNULL,
            stdout=events_file,
            stderr=subprocess.PIPE,
            text=True,
        )
    if result.returncode != 0:
        raise LauncherError(f"codex exec failed with exit code {result.returncode}: {result.stderr.strip()}")
    _read_json(output_path, output_name)
    return {
        "ok": True,
        "pai_dir": str(pai_dir),
        "output": str(output_path),
        "events_output": str(events_path),
        "schema": str(schema_path),
        "runtime_invocation": "codex exec --json --sandbox read-only --ephemeral --cd PAI_DIR",
    }


def exec_proof(
    pai_dir: Path,
    output: str | Path,
    events_output: str | Path,
    dry_run: bool = False,
) -> dict[str, object]:
    return _run_codex_exec(
        pai_dir,
        output,
        events_output,
        "runtime-proof.schema.json",
        RUNTIME_PROOF_NAME,
        RUNTIME_EVENTS_NAME,
        _proof_prompt(pai_dir),
        dry_run,
    )


def workloop_once(
    pai_dir: Path,
    output: str | Path,
    events_output: str | Path,
    dry_run: bool = False,
) -> dict[str, object]:
    return _run_codex_exec(
        pai_dir,
        output,
        events_output,
        "workloop-once.schema.json",
        WORKLOOP_NAME,
        WORKLOOP_EVENTS_NAME,
        _workloop_prompt(pai_dir),
        dry_run,
    )


def audit_run(
    pai_dir: Path,
    marker: str | Path,
    runtime_proof: str | Path,
    workloop: str | Path,
    runtime_events: str | Path,
    workloop_events: str | Path,
    output: str | Path,
    runtime_attempt_number: int,
) -> dict[str, object]:
    doctor(pai_dir)
    marker_path = _safe_existing_path(marker, "--marker")
    runtime_proof_path = _safe_run_input_path(pai_dir, runtime_proof, RUNTIME_PROOF_NAME, "--runtime-proof")
    workloop_path = _safe_run_input_path(pai_dir, workloop, WORKLOOP_NAME, "--workloop")
    runtime_events_path = _safe_run_input_path(pai_dir, runtime_events, RUNTIME_EVENTS_NAME, "--runtime-events")
    workloop_events_path = _safe_run_input_path(pai_dir, workloop_events, WORKLOOP_EVENTS_NAME, "--workloop-events")
    output_path = _safe_output_path(pai_dir, output, RUNTIME_VALIDATION_NAME)

    sys.path.insert(0, str(Path.cwd()))
    from tools.codex_adapter_installer.runtime_audit import audit_runtime

    result = audit_runtime(
        pai_dir=pai_dir,
        marker=marker_path,
        runtime_proof=runtime_proof_path,
        workloop=workloop_path,
        runtime_events=runtime_events_path,
        workloop_events=workloop_events_path,
        runtime_attempt_number=runtime_attempt_number,
        repo_root=Path.cwd(),
    )
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if not result.get("validation_passed"):
        raise LauncherError(f"event-attributed audit failed; wrote {output_path}")
    return {
        "ok": True,
        "output": str(output_path),
        "event_attribution_passed": result.get("event_attribution_passed"),
        "validation_passed": result.get("validation_passed"),
    }


def _default_output(pai_dir: Path, filename: str) -> Path:
    return _run_dir(pai_dir) / filename


def _task_run_dir(pai_dir: Path) -> Path:
    return pai_dir / TASK_RUN_RELATIVE


def _safe_task_run_dir(pai_dir: Path, run_dir: str | Path) -> Path:
    if str(run_dir) == "":
        raise LauncherError("--run-dir must not be empty")
    path = Path(run_dir)
    if any(part == ".." for part in path.parts):
        raise LauncherError("--run-dir must not contain path traversal")
    resolved = path.resolve(strict=False)
    expected = _task_run_dir(pai_dir).resolve(strict=False)
    if resolved != expected:
        raise LauncherError("S15C task run directory must be adapters/codex/runs/s15c")
    if path.exists() and not path.is_dir():
        raise LauncherError("--run-dir target is not a directory")
    if path.is_symlink():
        raise LauncherError("--run-dir target is a symlink")
    return path


def _safe_task_output_path(run_dir: Path, output: str | Path, expected_name: str, label: str) -> Path:
    if str(output) == "":
        raise LauncherError(f"{label} must not be empty")
    output_path = Path(output)
    if any(part == ".." for part in output_path.parts):
        raise LauncherError(f"{label} must not contain path traversal")
    resolved = output_path.resolve(strict=False)
    run_root = run_dir.resolve(strict=False)
    if not _is_within(run_root, resolved):
        raise LauncherError(f"{label} must stay under adapters/codex/runs/s15c")
    if resolved.name != expected_name:
        raise LauncherError(f"{label} must be named {expected_name}")
    if output_path.exists() and not output_path.is_file():
        raise LauncherError(f"{label} target is not a file")
    if output_path.is_symlink():
        raise LauncherError(f"{label} target is a symlink")
    return output_path


def _safe_task_input_path(run_dir: Path, path_value: str | Path, expected_name: str, label: str) -> Path:
    path = _safe_existing_path(path_value, label)
    run_root = run_dir.resolve(strict=False)
    if not _is_within(run_root, path):
        raise LauncherError(f"{label} must stay under adapters/codex/runs/s15c")
    if path.name != expected_name:
        raise LauncherError(f"{label} must be named {expected_name}")
    if not path.is_file():
        raise LauncherError(f"{label} must be a file")
    return path


def _safe_task_card_path(pai_dir: Path, task_card: str | Path) -> Path:
    path = _safe_existing_path(task_card, "--task-card")
    expected = (_adapter_dir(pai_dir) / "tasks" / "s15c-synthetic-bugfix.json").resolve(strict=True)
    if path != expected:
        raise LauncherError("--task-card must be the installed S15C synthetic task card")
    return path


def _load_task_card(path: Path) -> dict[str, object]:
    card = _read_json(path, "S15C task card")
    if card.get("task_id") != TASK_ID:
        raise LauncherError("S15C task card has unexpected task_id")
    if card.get("task_kind") != "bounded-synthetic-code-repair":
        raise LauncherError("S15C task card has unexpected task_kind")
    return card


def _fixture_dir(pai_dir: Path, task_card: dict[str, object]) -> Path:
    fixture = task_card.get("fixture")
    if not isinstance(fixture, str) or fixture != "task-fixtures/s15c_bugfix":
        raise LauncherError("S15C task card fixture is not approved")
    path = (_adapter_dir(pai_dir) / fixture).resolve(strict=True)
    if not _is_within(_adapter_dir(pai_dir).resolve(strict=True), path):
        raise LauncherError("S15C fixture escapes adapter directory")
    if not path.is_dir():
        raise LauncherError("S15C fixture is missing")
    return path


def _copy_fixture_to_workspace(fixture: Path, workspace: Path) -> None:
    if workspace.exists():
        if workspace.is_symlink() or not workspace.is_dir():
            raise LauncherError("S15C task workspace is not a safe directory")
        shutil.rmtree(workspace)
    workspace.parent.mkdir(parents=True, exist_ok=True)
    shutil.copytree(fixture, workspace, ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))


def _test_command(task_card: dict[str, object]) -> list[str]:
    command = task_card.get("test_command")
    if not isinstance(command, list) or not command or not all(isinstance(item, str) for item in command):
        raise LauncherError("S15C task card test_command is invalid")
    return list(command)


def _run_task_tests(workspace: Path, command: list[str]) -> subprocess.CompletedProcess[str]:
    env = dict(os.environ)
    env["PYTHONDONTWRITEBYTECODE"] = "1"
    return subprocess.run(
        command,
        cwd=workspace,
        stdin=subprocess.DEVNULL,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        env=env,
    )


def _snapshot_workspace(workspace: Path) -> dict[Path, str]:
    snapshot: dict[Path, str] = {}
    for path in sorted(workspace.rglob("*")):
        if not path.is_file() or "__pycache__" in path.parts or path.suffix == ".pyc":
            continue
        relative = path.relative_to(workspace)
        try:
            snapshot[relative] = path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            continue
    return snapshot


def _write_workspace_diff(before: dict[Path, str], workspace: Path, diff_path: Path) -> list[str]:
    after = _snapshot_workspace(workspace)
    modified: list[str] = []
    diff_lines: list[str] = []
    for relative in sorted(set(before) | set(after)):
        old = before.get(relative)
        new = after.get(relative)
        if old == new:
            continue
        modified.append(str(relative))
        old_lines = [] if old is None else old.splitlines(keepends=True)
        new_lines = [] if new is None else new.splitlines(keepends=True)
        diff_lines.extend(
            difflib.unified_diff(
                old_lines,
                new_lines,
                fromfile=f"a/{relative}",
                tofile=f"b/{relative}",
            )
        )
    diff_path.write_text("".join(diff_lines), encoding="utf-8")
    return modified


def _task_prompt(pai_dir: Path, workspace: Path, task_card: dict[str, object]) -> str:
    test_command = " ".join(_test_command(task_card))
    source_path = workspace / "src" / "pai_priority.py"
    test_path = workspace / "tests" / "test_pai_priority.py"
    brief_path = workspace / "README.md"
    source_text = source_path.read_text(encoding="utf-8")
    test_text = test_path.read_text(encoding="utf-8")
    brief_text = brief_path.read_text(encoding="utf-8")
    return (
        "You are executing the S15C bounded synthetic code task through the live PAI Codex adapter. "
        f"PAI_DIR is {str(pai_dir)!r}. "
        f"The isolated task workspace is {str(workspace)!r}. "
        f"The installed router identity marker observed by the launcher is {MARKER_VALUE!r}. "
        "Use only the task brief, implementation, and tests included in this prompt. Do not use tools or web search. "
        "Return a complete replacement for src/pai_priority.py in repair_file_content. "
        "The launcher will materialize that Codex-authored repair only inside the isolated task workspace and then run the tests. "
        "Do not request or describe changes to Memory, ISA, Pulse, repo governance files, Codex native install surfaces, or files outside the workspace. "
        "Fix normalize_priority in src/pai_priority.py so low, medium, high, and urgent aliases normalize consistently, invalid values raise ValueError, and the public function name is preserved. "
        f"Run the tests with {test_command!r}. "
        "Return only JSON matching the provided schema. "
        f"Use milestone_name {TASK_MILESTONE!r}, task_id {TASK_ID!r}, task_kind 'bounded-synthetic-code-repair', pai_dir {str(pai_dir)!r}, task_workspace {str(workspace)!r}. "
        "Report the adapter identity marker exactly as observed by the launcher. "
        "Set adapter_status peer-beta, upstream_adapter claude, agents_router_observed true, tests_passed true, memory_write_performed false, isa_write_performed false, pulse_probe_performed false, localhost_31337_called false, and runtime_surface_created false. "
        "Use files_modified values relative to the task workspace and set repair_file_path to 'src/pai_priority.py'. "
        "Use evidence_classification values including 'bounded task execution evidence', 'synthetic task evidence', and 'not replacement readiness'. "
        "Do not include any host-and-port endpoint string, raw Memory, ISA, Pulse, Claude product, Codex product, backup, or personal file contents. "
        f"TASK BRIEF:\n{brief_text}\n"
        f"CURRENT src/pai_priority.py:\n{source_text}\n"
        f"TESTS tests/test_pai_priority.py:\n{test_text}\n"
    )


def _build_task_codex_command(pai_dir: Path, workspace: Path, schema_path: Path, result_path: Path, prompt: str) -> list[str]:
    return [
        "codex",
        "--ask-for-approval",
        "never",
        "exec",
        "--enable",
        "use_legacy_landlock",
        "--disable",
        "browser_use",
        "--disable",
        "browser_use_external",
        "--ephemeral",
        "--ignore-rules",
        "--json",
        "--sandbox",
        "workspace-write",
        "--cd",
        str(workspace),
        "--skip-git-repo-check",
        "--output-schema",
        str(schema_path),
        "-o",
        str(result_path),
        prompt,
    ]


def _build_task_materialized_command(
    pai_dir: Path,
    workspace: Path,
    schema_path: Path,
    result_path: Path,
    prompt: str,
) -> list[str]:
    return [
        "codex",
        "--ask-for-approval",
        "never",
        "exec",
        "--ephemeral",
        "--ignore-rules",
        "--json",
        "--disable",
        "browser_use",
        "--disable",
        "browser_use_external",
        "--sandbox",
        "read-only",
        "--cd",
        str(workspace),
        "--skip-git-repo-check",
        "--output-schema",
        str(schema_path),
        "-o",
        str(result_path),
        prompt,
    ]


def _apply_materialized_repair(workspace: Path, task_result: dict[str, object]) -> None:
    repair_path = task_result.get("repair_file_path")
    repair_content = task_result.get("repair_file_content")
    if not isinstance(repair_path, str) or repair_path == "":
        return
    if not isinstance(repair_content, str):
        raise LauncherError("S15C task result repair_file_content must be a string")
    relative = Path(repair_path)
    if relative.is_absolute() or any(part == ".." for part in relative.parts):
        raise LauncherError("S15C task result repair_file_path escapes workspace")
    target = (workspace / relative).resolve(strict=False)
    if not _is_within(workspace.resolve(strict=True), target):
        raise LauncherError("S15C task result repair_file_path is outside workspace")
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(repair_content, encoding="utf-8")


def task_run(
    pai_dir: Path,
    task_card: str | Path,
    run_dir: str | Path,
    result: str | Path,
    events_output: str | Path,
    dry_run: bool = False,
) -> dict[str, object]:
    doctor(pai_dir)
    task_card_path = _safe_task_card_path(pai_dir, task_card)
    card = _load_task_card(task_card_path)
    safe_run_dir = _safe_task_run_dir(pai_dir, run_dir)
    result_path = _safe_task_output_path(safe_run_dir, result, TASK_RESULT_NAME, "--result")
    events_path = _safe_task_output_path(safe_run_dir, events_output, TASK_EVENTS_NAME, "--events-output")
    diff_path = safe_run_dir / TASK_DIFF_NAME
    state_path = safe_run_dir / TASK_STATE_NAME
    workspace = safe_run_dir / TASK_WORKSPACE_NAME
    if workspace.is_symlink():
        raise LauncherError("S15C task workspace is a symlink")

    fixture = _fixture_dir(pai_dir, card)
    _copy_fixture_to_workspace(fixture, workspace)
    test_command = _test_command(card)
    initial = _run_task_tests(workspace, test_command)
    if initial.returncode == 0:
        raise LauncherError("S15C task fixture unexpectedly passed before repair")
    before = _snapshot_workspace(workspace)
    schema_path = _adapter_dir(pai_dir) / "task-result.schema.json"
    if not schema_path.is_file():
        raise LauncherError("task result schema is missing")
    prompt = _task_prompt(pai_dir, workspace, card)
    workspace_write_command = _build_task_codex_command(pai_dir, workspace, schema_path, result_path, prompt)
    command = _build_task_materialized_command(pai_dir, workspace, schema_path, result_path, prompt)

    if dry_run:
        state = {
            "codex_exec_command": command,
            "workspace_write_command": workspace_write_command,
            "initial_test_returncode": initial.returncode,
            "post_test_returncode": None,
            "task_workspace": str(workspace),
        }
        state_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return {
            "dry_run": True,
            "command": command,
            "workspace_write_command": workspace_write_command,
            "cwd": str(workspace),
            "result": str(result_path),
            "events_output": str(events_path),
            "schema": str(schema_path),
            "task_workspace": str(workspace),
            "initial_test_returncode": initial.returncode,
        }

    result_path.parent.mkdir(parents=True, exist_ok=True)
    events_path.parent.mkdir(parents=True, exist_ok=True)
    with events_path.open("w", encoding="utf-8") as events_file:
        completed = subprocess.run(
            command,
            cwd=workspace,
            stdin=subprocess.DEVNULL,
            stdout=events_file,
            stderr=subprocess.PIPE,
            text=True,
        )
    if completed.returncode != 0:
        raise LauncherError(f"codex task exec failed with exit code {completed.returncode}: {completed.stderr.strip()}")
    task_result = _read_json(result_path, TASK_RESULT_NAME)
    _apply_materialized_repair(workspace, task_result)
    post = _run_task_tests(workspace, test_command)
    modified = _write_workspace_diff(before, workspace, diff_path)
    state = {
        "codex_exec_command": command,
        "workspace_write_command": workspace_write_command,
        "initial_test_returncode": initial.returncode,
        "post_test_returncode": post.returncode,
        "task_workspace": str(workspace),
        "files_modified_by_diff": modified,
    }
    state_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if post.returncode != 0:
        raise LauncherError("S15C task tests did not pass after Codex repair")
    if not modified:
        raise LauncherError("S15C task did not produce a workspace diff")
    return {
        "ok": True,
        "pai_dir": str(pai_dir),
        "task_workspace": str(workspace),
        "result": str(result_path),
        "events_output": str(events_path),
        "diff": str(diff_path),
        "runtime_invocation": "codex exec --json --sandbox read-only --ephemeral --cd S15C_WORKSPACE with launcher-materialized repair",
    }


def _provider_doctor(pai_dir: Path) -> dict[str, object]:
    router = pai_dir / "AGENTS.md"
    if not router.is_file():
        raise LauncherError("PAI_DIR/AGENTS.md is missing")
    router_text = router.read_text(encoding="utf-8")
    if MARKER_VALUE not in router_text:
        raise LauncherError(f"PAI_DIR/AGENTS.md is missing {MARKER_NAME}")
    for path, label in (
        (pai_dir / "runtime-schemas" / "run-result.schema.json", "PAI run result schema"),
        (pai_dir / PROVIDER_TASK_CARD_RELATIVE, "S15D task card"),
        (pai_dir / PROVIDER_FIXTURE_RELATIVE / "src" / "pai_priority.py", "S15D task fixture"),
    ):
        if not path.is_file():
            raise LauncherError(f"{label} is missing: {path}")
    return {
        "ok": True,
        "pai_dir": str(pai_dir),
        "runtime": "codex",
        "adapter_identity_marker_observed": True,
    }


def _provider_run_dir(pai_dir: Path) -> Path:
    return pai_dir / PROVIDER_RUN_RELATIVE


def _safe_provider_run_dir(pai_dir: Path, run_dir: str | Path) -> Path:
    if str(run_dir) == "":
        raise LauncherError("--run-dir must not be empty")
    path = Path(run_dir)
    if any(part == ".." for part in path.parts):
        raise LauncherError("--run-dir must not contain path traversal")
    resolved = path.resolve(strict=False)
    expected = _provider_run_dir(pai_dir).resolve(strict=False)
    if resolved != expected:
        raise LauncherError("PAI provider run directory must be runs/s15d/codex-synthetic-bugfix")
    if path.exists() and not path.is_dir():
        raise LauncherError("--run-dir target is not a directory")
    if path.is_symlink():
        raise LauncherError("--run-dir target is a symlink")
    return path


def _safe_provider_output_path(run_dir: Path, output: str | Path, expected_name: str, label: str) -> Path:
    if str(output) == "":
        raise LauncherError(f"{label} must not be empty")
    output_path = Path(output)
    if any(part == ".." for part in output_path.parts):
        raise LauncherError(f"{label} must not contain path traversal")
    resolved = output_path.resolve(strict=False)
    run_root = run_dir.resolve(strict=False)
    if not _is_within(run_root, resolved):
        raise LauncherError(f"{label} must stay under runs/s15d/codex-synthetic-bugfix")
    if resolved.name != expected_name:
        raise LauncherError(f"{label} must be named {expected_name}")
    if output_path.exists() and not output_path.is_file():
        raise LauncherError(f"{label} target is not a file")
    if output_path.is_symlink():
        raise LauncherError(f"{label} target is a symlink")
    return output_path


def _safe_provider_task_card_path(pai_dir: Path, task_card: str | Path) -> Path:
    path = _safe_existing_path(task_card, "--task-card")
    expected = (pai_dir / PROVIDER_TASK_CARD_RELATIVE).resolve(strict=True)
    if path != expected:
        raise LauncherError("--task-card must be the installed S15D synthetic task card")
    return path


def _load_provider_task_card(path: Path) -> dict[str, object]:
    card = _read_json(path, "S15D task card")
    if card.get("task_id") != PROVIDER_RUN_ID:
        raise LauncherError("S15D task card has unexpected task_id")
    if card.get("task_kind") != "bounded-synthetic-code-repair":
        raise LauncherError("S15D task card has unexpected task_kind")
    if card.get("runtime") != "codex":
        raise LauncherError("S15D task card runtime must be codex")
    return card


def _provider_fixture_dir(pai_dir: Path, task_card: dict[str, object]) -> Path:
    fixture = task_card.get("fixture")
    if not isinstance(fixture, str) or fixture != str(PROVIDER_FIXTURE_RELATIVE):
        raise LauncherError("S15D task card fixture is not approved")
    path = (pai_dir / fixture).resolve(strict=True)
    if not _is_within(pai_dir.resolve(strict=True), path):
        raise LauncherError("S15D fixture escapes PAI_DIR")
    if not path.is_dir():
        raise LauncherError("S15D fixture is missing")
    return path


def _provider_task_prompt(pai_dir: Path, workspace: Path, task_card: dict[str, object]) -> str:
    test_command = " ".join(_test_command(task_card))
    source_path = workspace / "src" / "pai_priority.py"
    test_path = workspace / "tests" / "test_pai_priority.py"
    brief_path = workspace / "README.md"
    source_text = source_path.read_text(encoding="utf-8")
    test_text = test_path.read_text(encoding="utf-8")
    brief_text = brief_path.read_text(encoding="utf-8")
    return (
        "You are Codex running as runtime provider codex under the PAI-owned runtime runner. "
        "PAI owns the run, the task card, the run directory, validation, and Memory/ISA/Pulse policy. "
        f"PAI_DIR is {str(pai_dir)!r}. "
        f"The PAI-owned isolated task workspace is {str(workspace)!r}. "
        f"The installed router identity marker observed by the provider launcher is {MARKER_VALUE!r}. "
        "Use only the task brief, implementation, and tests included in this prompt. Do not use tools or web search. "
        "Return a complete replacement for src/pai_priority.py in repair_file_content. "
        "The PAI runtime provider driver will materialize that Codex-authored repair only inside the PAI-owned task workspace and then run the tests. "
        "Do not request or describe changes to Memory, ISA, Pulse, repo governance files, Codex native install surfaces, adapter install surfaces, or files outside the workspace. "
        "Fix normalize_priority in src/pai_priority.py so low, medium, high, and urgent aliases normalize consistently, invalid values raise ValueError, and the public function name is preserved. "
        f"Run the tests with {test_command!r}. "
        "Return only JSON matching the provided schema. "
        f"Use milestone_name {PROVIDER_MILESTONE!r}, run_id {PROVIDER_RUN_ID!r}, runtime 'codex', runtime_status 'peer-beta', provider_type 'codex-cli', pai_dir {str(pai_dir)!r}. "
        f"Use task_id {PROVIDER_RUN_ID!r}, task_kind 'bounded-synthetic-code-repair', task_workspace {str(workspace)!r}, and pai_owned_run_directory true. "
        "Report the adapter identity marker exactly as observed by the provider launcher. "
        "Set adapter_status peer-beta, upstream_adapter claude, agents_router_observed true, tests_passed true, memory_write_performed false, isa_write_performed false, pulse_probe_performed false, localhost_31337_called false, and runtime_surface_created false. "
        "Use files_modified values relative to the task workspace and set repair_file_path to 'src/pai_priority.py'. "
        "Use evidence_classification values including 'PAI-owned runtime task evidence', 'bounded synthetic task evidence', and 'not replacement readiness'. "
        "Do not include any host-and-port endpoint string, raw Memory, ISA, Pulse, Claude product, Codex product, backup, or personal file contents. "
        f"TASK BRIEF:\n{brief_text}\n"
        f"CURRENT src/pai_priority.py:\n{source_text}\n"
        f"TESTS tests/test_pai_priority.py:\n{test_text}\n"
    )


def provider_run(
    pai_dir: Path,
    task_card: str | Path,
    run_dir: str | Path,
    result: str | Path,
    events_output: str | Path,
    dry_run: bool = False,
) -> dict[str, object]:
    _provider_doctor(pai_dir)
    task_card_path = _safe_provider_task_card_path(pai_dir, task_card)
    card = _load_provider_task_card(task_card_path)
    safe_run_dir = _safe_provider_run_dir(pai_dir, run_dir)
    result_path = _safe_provider_output_path(safe_run_dir, result, PROVIDER_RESULT_NAME, "--result")
    events_path = _safe_provider_output_path(safe_run_dir, events_output, PROVIDER_EVENTS_NAME, "--events-output")
    diff_path = safe_run_dir / PROVIDER_DIFF_NAME
    state_path = safe_run_dir / PROVIDER_STATE_NAME
    workspace = safe_run_dir / TASK_WORKSPACE_NAME
    if workspace.is_symlink():
        raise LauncherError("S15D task workspace is a symlink")

    fixture = _provider_fixture_dir(pai_dir, card)
    _copy_fixture_to_workspace(fixture, workspace)
    test_command = _test_command(card)
    initial = _run_task_tests(workspace, test_command)
    if initial.returncode == 0:
        raise LauncherError("S15D task fixture unexpectedly passed before repair")
    before = _snapshot_workspace(workspace)
    schema_path = pai_dir / "runtime-schemas" / "run-result.schema.json"
    if not schema_path.is_file():
        raise LauncherError("PAI run result schema is missing")
    prompt = _provider_task_prompt(pai_dir, workspace, card)
    workspace_write_command = _build_task_codex_command(pai_dir, workspace, schema_path, result_path, prompt)
    command = _build_task_materialized_command(pai_dir, workspace, schema_path, result_path, prompt)

    if dry_run:
        state = {
            "codex_exec_command": command,
            "workspace_write_command": workspace_write_command,
            "initial_test_returncode": initial.returncode,
            "post_test_returncode": None,
            "task_workspace": str(workspace),
        }
        state_path.parent.mkdir(parents=True, exist_ok=True)
        state_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
        return {
            "dry_run": True,
            "command": command,
            "workspace_write_command": workspace_write_command,
            "cwd": str(workspace),
            "result": str(result_path),
            "events_output": str(events_path),
            "schema": str(schema_path),
            "task_workspace": str(workspace),
            "initial_test_returncode": initial.returncode,
        }

    result_path.parent.mkdir(parents=True, exist_ok=True)
    events_path.parent.mkdir(parents=True, exist_ok=True)
    with events_path.open("w", encoding="utf-8") as events_file:
        completed = subprocess.run(
            command,
            cwd=workspace,
            stdin=subprocess.DEVNULL,
            stdout=events_file,
            stderr=subprocess.PIPE,
            text=True,
        )
    if completed.returncode != 0:
        raise LauncherError(f"codex provider exec failed with exit code {completed.returncode}: {completed.stderr.strip()}")
    run_result = _read_json(result_path, PROVIDER_RESULT_NAME)
    _apply_materialized_repair(workspace, run_result)
    post = _run_task_tests(workspace, test_command)
    modified = _write_workspace_diff(before, workspace, diff_path)
    state = {
        "codex_exec_command": command,
        "workspace_write_command": workspace_write_command,
        "initial_test_returncode": initial.returncode,
        "post_test_returncode": post.returncode,
        "task_workspace": str(workspace),
        "files_modified_by_diff": modified,
    }
    state_path.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if post.returncode != 0:
        raise LauncherError("S15D task tests did not pass after Codex repair")
    if not modified:
        raise LauncherError("S15D task did not produce a workspace diff")
    return {
        "ok": True,
        "pai_dir": str(pai_dir),
        "run_id": PROVIDER_RUN_ID,
        "runtime": "codex",
        "task_workspace": str(workspace),
        "result": str(result_path),
        "events_output": str(events_path),
        "diff": str(diff_path),
        "runtime_invocation": "codex exec --json --sandbox read-only --ephemeral --cd PAI_OWNED_WORKSPACE with provider-materialized repair",
    }


def audit_task(
    pai_dir: Path,
    marker: str | Path,
    run_dir: str | Path,
    task_result: str | Path,
    task_events: str | Path,
    output: str | Path,
    runtime_attempt_number: int,
) -> dict[str, object]:
    doctor(pai_dir)
    marker_path = _safe_existing_path(marker, "--marker")
    safe_run_dir = _safe_task_run_dir(pai_dir, run_dir)
    result_path = _safe_task_input_path(safe_run_dir, task_result, TASK_RESULT_NAME, "--task-result")
    events_path = _safe_task_input_path(safe_run_dir, task_events, TASK_EVENTS_NAME, "--task-events")
    output_path = _safe_task_output_path(safe_run_dir, output, TASK_VALIDATION_NAME, "--output")

    sys.path.insert(0, str(Path.cwd()))
    from tools.codex_adapter_installer.task_audit import audit_task as run_task_audit

    result = run_task_audit(
        pai_dir=pai_dir,
        marker=marker_path,
        run_dir=safe_run_dir,
        task_result=result_path,
        task_events=events_path,
        runtime_attempt_number=runtime_attempt_number,
        repo_root=Path.cwd(),
    )
    output_path.parent.mkdir(parents=True, exist_ok=True)
    output_path.write_text(json.dumps(result, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    if not result.get("validation_passed"):
        raise LauncherError(f"S15C task audit failed; wrote {output_path}")
    return {
        "ok": True,
        "output": str(output_path),
        "event_attribution_passed": result.get("event_attribution_passed"),
        "validation_passed": result.get("validation_passed"),
    }


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description="PAI Codex contained runtime launcher.")
    subcommands = parser.add_subparsers(dest="command", required=True)

    doctor_parser = subcommands.add_parser("doctor")
    doctor_parser.add_argument("--pai-dir", required=True)

    proof_parser = subcommands.add_parser("exec-proof")
    proof_parser.add_argument("--pai-dir", required=True)
    proof_parser.add_argument("--output")
    proof_parser.add_argument("--events-output")
    proof_parser.add_argument("--dry-run", action="store_true")

    workloop_parser = subcommands.add_parser("workloop-once")
    workloop_parser.add_argument("--pai-dir", required=True)
    workloop_parser.add_argument("--output")
    workloop_parser.add_argument("--events-output")
    workloop_parser.add_argument("--dry-run", action="store_true")

    audit_parser = subcommands.add_parser("audit-run")
    audit_parser.add_argument("--pai-dir", required=True)
    audit_parser.add_argument("--marker", required=True)
    audit_parser.add_argument("--runtime-proof", required=True)
    audit_parser.add_argument("--workloop", required=True)
    audit_parser.add_argument("--runtime-events", required=True)
    audit_parser.add_argument("--workloop-events", required=True)
    audit_parser.add_argument("--output")
    audit_parser.add_argument("--runtime-attempt-number", type=int, default=1)

    task_parser = subcommands.add_parser("task-run")
    task_parser.add_argument("--pai-dir", required=True)
    task_parser.add_argument("--task-card", required=True)
    task_parser.add_argument("--run-dir", required=True)
    task_parser.add_argument("--result", required=True)
    task_parser.add_argument("--events-output", required=True)
    task_parser.add_argument("--dry-run", action="store_true")

    provider_parser = subcommands.add_parser("provider-run")
    provider_parser.add_argument("--pai-dir", required=True)
    provider_parser.add_argument("--task-card", required=True)
    provider_parser.add_argument("--run-dir", required=True)
    provider_parser.add_argument("--result", required=True)
    provider_parser.add_argument("--events-output", required=True)
    provider_parser.add_argument("--dry-run", action="store_true")

    task_audit_parser = subcommands.add_parser("audit-task")
    task_audit_parser.add_argument("--pai-dir", required=True)
    task_audit_parser.add_argument("--marker", required=True)
    task_audit_parser.add_argument("--run-dir", required=True)
    task_audit_parser.add_argument("--task-result", required=True)
    task_audit_parser.add_argument("--task-events", required=True)
    task_audit_parser.add_argument("--output", required=True)
    task_audit_parser.add_argument("--runtime-attempt-number", type=int, default=1)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        pai_dir = _resolve_pai_dir(args.pai_dir)
        if args.command == "doctor":
            result = doctor(pai_dir)
        elif args.command == "exec-proof":
            output = args.output or _default_output(pai_dir, RUNTIME_PROOF_NAME)
            events_output = args.events_output or _default_output(pai_dir, RUNTIME_EVENTS_NAME)
            result = exec_proof(pai_dir, output, events_output, args.dry_run)
        elif args.command == "workloop-once":
            output = args.output or _default_output(pai_dir, WORKLOOP_NAME)
            events_output = args.events_output or _default_output(pai_dir, WORKLOOP_EVENTS_NAME)
            result = workloop_once(pai_dir, output, events_output, args.dry_run)
        elif args.command == "audit-run":
            output = args.output or _default_output(pai_dir, RUNTIME_VALIDATION_NAME)
            result = audit_run(
                pai_dir,
                args.marker,
                args.runtime_proof,
                args.workloop,
                args.runtime_events,
                args.workloop_events,
                output,
                args.runtime_attempt_number,
            )
        elif args.command == "task-run":
            result = task_run(
                pai_dir,
                args.task_card,
                args.run_dir,
                args.result,
                args.events_output,
                args.dry_run,
            )
        elif args.command == "provider-run":
            result = provider_run(
                pai_dir,
                args.task_card,
                args.run_dir,
                args.result,
                args.events_output,
                args.dry_run,
            )
        elif args.command == "audit-task":
            result = audit_task(
                pai_dir,
                args.marker,
                args.run_dir,
                args.task_result,
                args.task_events,
                args.output,
                args.runtime_attempt_number,
            )
        else:
            raise LauncherError(f"unknown command: {args.command}")
    except (LauncherError, OSError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(result, indent=2, sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
