{
  "adapter_name": "codex",
  "adapter_status": "peer-beta",
  "upstream_adapter": "claude",
  "payload_type": "live-installable-router",
  "install_target": "~/.claude/PAI/AGENTS.md",
  "live_install_status": "installed-by-installer-only",
  "milestone_name": "V5-S15B-R2-CODEX-RUNTIME-EVENT-ATTRIBUTED-WORKLOOP",
  "adapter_identity_marker": "PAI_CODEX_PEER_BETA_ADAPTER",
  "authority_layers": {
    "pai_system_prompt": "PAI_SYSTEM_PROMPT.md remains a first-class high-authority instruction layer.",
    "router": "AGENTS.md is a compact Codex router into PAI v5, not a clone of CLAUDE.md.",
    "upstream": "Claude remains the official/full-support upstream adapter."
  },
  "memory_policy": {
    "status": "writes-not-approved",
    "rule": "Codex must not write PAI Memory unless a later architect-approved policy allows it.",
    "memory_version": "Memory v7.6",
    "domains": [
      "WORK",
      "LEARNING",
      "KNOWLEDGE"
    ]
  },
  "isa_policy": {
    "status": "writes-not-approved",
    "rule": "Codex must not write ISA unless a later architect-approved policy allows it.",
    "system_of_record": "ISA replaces PRD as the work/system-of-record primitive."
  },
  "pulse_policy": {
    "status": "no-start-no-probe-no-call",
    "surface": "Pulse is the central daemon/dashboard/event surface on localhost:31337.",
    "bridge_status": "not-approved"
  },
  "runtime_launcher_policy": {
    "status": "contained-read-only-runtime-approved",
    "launcher_target": "~/.claude/PAI/adapters/codex/bin/pai-codex",
    "commands": [
      "doctor",
      "exec-proof",
      "workloop-once",
      "audit-run"
    ],
    "runtime_mode": "codex exec with --sandbox read-only, --ephemeral, and --json event capture",
    "run_directory": "~/.claude/PAI/adapters/codex/runs/s15b-r2/",
    "event_streams": [
      "runtime-events.jsonl",
      "workloop-events.jsonl"
    ],
    "replacement_readiness": "not-approved"
  },
  "runtime_surface_policy": {
    "claude_shaped_files": "must-not-be-copied-directly-into-codex-native-surfaces",
    "not_approved_by_this_milestone": [
      "repo root AGENTS.md",
      "repo .codex/",
      "~/.codex adapter files",
      "Codex hooks",
      "Codex rules",
      "Codex skills",
      "Codex agents",
      "Codex commands",
      "Codex launchers outside ~/.claude/PAI/adapters/codex/bin/",
      "Pulse bridge",
      "Memory writer",
      "ISA writer"
    ]
  },
  "rollback_policy": {
    "backup_required_before_live_writes": true,
    "backup_shape": "~/.pai-codex-adapter-backups/s15b-r2-<UTC_TIMESTAMP>/.claude/",
    "rollback_command_shape": "python3 -m tools.codex_adapter_installer --pai-dir \"$HOME/.claude/PAI\" --backup-root \"<backup-root>\" --rollback"
  }
}
