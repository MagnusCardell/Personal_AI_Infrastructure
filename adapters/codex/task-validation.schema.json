{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S15C Bounded Task Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "task_id",
    "runtime_attempt_number",
    "codex_exec_command",
    "task_workspace",
    "task_initially_failed",
    "task_tests_passed_after_repair",
    "diff_present",
    "diff_limited_to_task_workspace",
    "event_logs_present",
    "event_attribution_passed",
    "codex_file_change_events",
    "codex_command_execution_events",
    "approved_task_workspace_writes",
    "approved_adapter_writes",
    "ambient_pai_state_churn",
    "forbidden_semantic_writes",
    "unknown_unclassified_writes",
    "memory_write_performed_by_codex",
    "isa_write_performed_by_codex",
    "pulse_probe_performed_by_codex",
    "localhost_31337_called_by_codex",
    "repo_root_agents_created",
    "repo_dotcodex_created",
    "codex_adapter_files_installed_under_home_codex",
    "validation_passed",
    "known_limits"
  ],
  "properties": {
    "milestone_name": {
      "type": "string",
      "const": "V5-S15C-CODEX-BOUNDED-TASK-EXECUTION"
    },
    "task_id": {
      "type": "string",
      "const": "s15c-synthetic-bugfix"
    },
    "runtime_attempt_number": {
      "type": "integer",
      "minimum": 1
    },
    "codex_exec_command": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "task_workspace": {
      "type": "string"
    },
    "task_initially_failed": {
      "type": "boolean"
    },
    "task_tests_passed_after_repair": {
      "type": "boolean"
    },
    "diff_present": {
      "type": "boolean"
    },
    "diff_limited_to_task_workspace": {
      "type": "boolean"
    },
    "event_logs_present": {
      "type": "boolean"
    },
    "event_attribution_passed": {
      "type": "boolean"
    },
    "codex_file_change_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "codex_command_execution_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "approved_task_workspace_writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approved_adapter_writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "ambient_pai_state_churn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_semantic_writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknown_unclassified_writes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_write_performed_by_codex": {
      "type": "boolean"
    },
    "isa_write_performed_by_codex": {
      "type": "boolean"
    },
    "pulse_probe_performed_by_codex": {
      "type": "boolean"
    },
    "localhost_31337_called_by_codex": {
      "type": "boolean"
    },
    "repo_root_agents_created": {
      "type": "boolean"
    },
    "repo_dotcodex_created": {
      "type": "boolean"
    },
    "codex_adapter_files_installed_under_home_codex": {
      "type": "boolean"
    },
    "validation_passed": {
      "type": "boolean"
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "runtime_warnings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "classifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
