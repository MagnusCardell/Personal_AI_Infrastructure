{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Codex Beta Readiness Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "runtime",
    "runtime_status",
    "provider_type",
    "pai_dir",
    "adapter_identity_marker",
    "upstream_adapter",
    "agents_router_observed",
    "pai_runtime_installed",
    "provider_registry_passed",
    "provider_lifecycle_passed",
    "capability_policy_passed",
    "patch_proposal_policy_passed",
    "readonly_pai_context_policy_passed",
    "event_attribution_passed",
    "protected_surface_check_passed",
    "memory_write_performed",
    "isa_write_performed",
    "memory_body_read",
    "isa_body_read",
    "pulse_event_payload_read",
    "pulse_probe_performed",
    "localhost_31337_called",
    "repo_root_agents_created",
    "repo_dotcodex_created",
    "codex_adapter_files_installed_under_home_codex",
    "replacement_readiness_claimed",
    "claude_equivalence_claimed",
    "beta_readiness_status",
    "evidence_classification",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S15J-PAI-RUNTIME-CODEX-BETA-READINESS-GATE" },
    "run_id": { "type": "string", "const": "s15j-codex-beta-readiness" },
    "runtime": { "type": "string", "const": "codex" },
    "runtime_status": { "type": "string", "const": "peer-beta" },
    "provider_type": { "type": "string", "const": "codex-cli" },
    "pai_dir": { "type": "string", "const": "~/.claude/PAI" },
    "adapter_identity_marker": { "type": "string", "const": "PAI_CODEX_PEER_BETA_ADAPTER" },
    "upstream_adapter": { "type": "string", "const": "claude" },
    "agents_router_observed": { "type": "boolean", "const": true },
    "pai_runtime_installed": { "type": "boolean", "const": true },
    "provider_registry_passed": { "type": "boolean", "const": true },
    "provider_lifecycle_passed": { "type": "boolean", "const": true },
    "capability_policy_passed": { "type": "boolean", "const": true },
    "patch_proposal_policy_passed": { "type": "boolean", "const": true },
    "readonly_pai_context_policy_passed": { "type": "boolean", "const": true },
    "event_attribution_passed": { "type": "boolean", "const": true },
    "protected_surface_check_passed": { "type": "boolean", "const": true },
    "memory_write_performed": { "type": "boolean", "const": false },
    "isa_write_performed": { "type": "boolean", "const": false },
    "memory_body_read": { "type": "boolean", "const": false },
    "isa_body_read": { "type": "boolean", "const": false },
    "pulse_event_payload_read": { "type": "boolean", "const": false },
    "pulse_probe_performed": { "type": "boolean", "const": false },
    "localhost_31337_called": { "type": "boolean", "const": false },
    "repo_root_agents_created": { "type": "boolean", "const": false },
    "repo_dotcodex_created": { "type": "boolean", "const": false },
    "codex_adapter_files_installed_under_home_codex": { "type": "boolean", "const": false },
    "replacement_readiness_claimed": { "type": "boolean", "const": false },
    "claude_equivalence_claimed": { "type": "boolean", "const": false },
    "beta_readiness_status": { "type": "string", "const": "peer-beta-runtime-provider" },
    "evidence_classification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "known_limits": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  }
}
