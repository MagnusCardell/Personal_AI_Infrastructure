{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Single-Proposal Shadow Commit Policy Review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "runtime",
    "runtime_status",
    "provider_type",
    "task_id",
    "task_kind",
    "adapter_identity_marker",
    "upstream_adapter",
    "agents_router_observed",
    "source_dry_run_plan_run_id",
    "source_dry_run_plan_used",
    "context_capsule_used",
    "context_capsule_metadata_only",
    "human_gate_observed",
    "shadow_apply_only",
    "single_candidate_policy_observed",
    "commit_authority_requested",
    "commit_authority_granted",
    "commit_performed",
    "memory_write_performed",
    "isa_write_performed",
    "pulse_probe_performed",
    "localhost_31337_called",
    "evidence_classification",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S16D-PAI-STATE-SINGLE-PROPOSAL-SHADOW-COMMIT" },
    "run_id": { "type": "string", "const": "s16d-single-proposal-shadow-commit" },
    "runtime": { "type": "string", "const": "codex" },
    "runtime_status": { "type": "string", "const": "peer-beta" },
    "provider_type": { "type": "string", "const": "codex-cli" },
    "task_id": { "type": "string", "const": "s16d-state-shadow-commit-task" },
    "task_kind": { "type": "string", "const": "single-proposal-shadow-commit-policy" },
    "adapter_identity_marker": { "type": "string", "const": "PAI_CODEX_PEER_BETA_ADAPTER" },
    "upstream_adapter": { "type": "string", "const": "claude" },
    "agents_router_observed": { "type": "boolean", "const": true },
    "source_dry_run_plan_run_id": { "type": "string", "const": "s16c-commit-dry-run" },
    "source_dry_run_plan_used": { "type": "boolean", "const": true },
    "context_capsule_used": { "type": "boolean", "const": true },
    "context_capsule_metadata_only": { "type": "boolean", "const": true },
    "human_gate_observed": { "type": "boolean", "const": true },
    "shadow_apply_only": { "type": "boolean", "const": true },
    "single_candidate_policy_observed": { "type": "boolean", "const": true },
    "commit_authority_requested": { "type": "boolean", "const": false },
    "commit_authority_granted": { "type": "boolean", "const": false },
    "commit_performed": { "type": "boolean", "const": false },
    "memory_write_performed": { "type": "boolean", "const": false },
    "isa_write_performed": { "type": "boolean", "const": false },
    "pulse_probe_performed": { "type": "boolean", "const": false },
    "localhost_31337_called": { "type": "boolean", "const": false },
    "evidence_classification": { "type": "array", "items": { "type": "string" } },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  }
}
