{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Selected Commit Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "source_dry_run_plan_run_id",
    "selection_authority",
    "selection_policy",
    "selected_candidate_count",
    "human_gate",
    "selected_candidate_kind",
    "selected_proposal_id",
    "relative_target_path",
    "target_path_family",
    "dry_run_status_from_source",
    "rendered_content_present",
    "selection_status",
    "commit_authority_granted",
    "commit_performed",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S16D-PAI-STATE-SINGLE-PROPOSAL-SHADOW-COMMIT" },
    "run_id": { "type": "string", "const": "s16d-single-proposal-shadow-commit" },
    "source_dry_run_plan_run_id": { "type": "string", "const": "s16c-commit-dry-run" },
    "selection_authority": { "type": "string", "const": "pai-policy" },
    "selection_policy": { "type": "string", "const": "first-memory-lexical-else-first-isa-lexical" },
    "selected_candidate_count": { "type": "integer", "const": 1 },
    "human_gate": { "type": "string", "const": "S16D_SHADOW_APPLY_ONLY_NO_LIVE_MEMORY_ISA_WRITE" },
    "selected_candidate_kind": { "type": "string", "enum": ["memory", "isa"] },
    "selected_proposal_id": { "type": "string" },
    "relative_target_path": {
      "type": "string",
      "pattern": "^(Memory/(WORK|LEARNING|KNOWLEDGE)/|ISA/)(?!.*(^|/)\\.\\.(/|$)).+"
    },
    "target_path_family": { "type": "string", "enum": ["Memory/WORK", "Memory/LEARNING", "Memory/KNOWLEDGE", "ISA"] },
    "dry_run_status_from_source": { "type": "string", "const": "not_written" },
    "rendered_content_present": { "type": "boolean", "const": true },
    "selection_status": { "type": "string", "const": "selected_for_shadow_apply_only" },
    "commit_authority_granted": { "type": "boolean", "const": false },
    "commit_performed": { "type": "boolean", "const": false },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  }
}
