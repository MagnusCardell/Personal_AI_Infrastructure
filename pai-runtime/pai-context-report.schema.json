{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Read-Only Context Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "runtime",
    "runtime_status",
    "provider_type",
    "pai_dir_label",
    "task_id",
    "task_kind",
    "adapter_identity_marker",
    "upstream_adapter",
    "agents_router_observed",
    "context_capsule_used",
    "context_capsule_metadata_only",
    "runtime_provider_count",
    "runtime_provider_names",
    "codex_provider_status",
    "codex_capabilities_observed",
    "memory_categories_observed",
    "memory_body_read",
    "isa_body_read",
    "pulse_event_payload_read",
    "claude_project_memory_read",
    "codex_memory_read",
    "pulse_probe_performed",
    "localhost_31337_called",
    "context_summary",
    "evidence_classification",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "enum": ["V5-S15I-PAI-RUNTIME-READONLY-PAI-CONTEXT-TASK"] },
    "run_id": { "type": "string", "enum": ["s15i-read-only-pai-context"] },
    "runtime": { "type": "string", "enum": ["codex"] },
    "runtime_status": { "type": "string", "enum": ["peer-beta"] },
    "provider_type": { "type": "string", "enum": ["codex-cli"] },
    "pai_dir_label": { "type": "string", "enum": ["~/.claude/PAI"] },
    "task_id": { "type": "string", "enum": ["s15i-readonly-pai-context-task"] },
    "task_kind": { "type": "string", "enum": ["readonly-pai-metadata-context"] },
    "adapter_identity_marker": { "type": "string", "enum": ["PAI_CODEX_PEER_BETA_ADAPTER"] },
    "upstream_adapter": { "type": "string", "enum": ["claude"] },
    "agents_router_observed": { "type": "boolean", "enum": [true] },
    "context_capsule_used": { "type": "boolean", "enum": [true] },
    "context_capsule_metadata_only": { "type": "boolean", "enum": [true] },
    "runtime_provider_count": { "type": "integer" },
    "runtime_provider_names": { "type": "array", "items": { "type": "string" } },
    "codex_provider_status": { "type": "string", "enum": ["peer-beta"] },
    "codex_capabilities_observed": { "type": "array", "items": { "type": "string" } },
    "memory_categories_observed": { "type": "array", "items": { "type": "string" } },
    "memory_body_read": { "type": "boolean", "enum": [false] },
    "isa_body_read": { "type": "boolean", "enum": [false] },
    "pulse_event_payload_read": { "type": "boolean", "enum": [false] },
    "claude_project_memory_read": { "type": "boolean", "enum": [false] },
    "codex_memory_read": { "type": "boolean", "enum": [false] },
    "pulse_probe_performed": { "type": "boolean", "enum": [false] },
    "localhost_31337_called": { "type": "boolean", "enum": [false] },
    "context_summary": { "type": "string" },
    "evidence_classification": { "type": "array", "items": { "type": "string" } },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  }
}
