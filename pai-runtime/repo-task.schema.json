{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Runtime Repository Task",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "milestone_name",
    "task_id",
    "task_kind",
    "runtime",
    "run_id",
    "approved_repository_write_set",
    "repository_target_files",
    "test_command"
  ],
  "properties": {
    "milestone_name": {
      "type": "string",
      "enum": [
        "V5-S15E-PAI-RUNTIME-CODEX-REAL-REPO-TASK",
        "V5-S15F-PAI-RUNTIME-PATCH-PROPOSAL-APPLIER"
      ]
    },
    "task_id": {
      "type": "string",
      "enum": [
        "s15e-provider-registry-repo-task",
        "s15f-patch-proposal-repo-task"
      ]
    },
    "task_kind": { "type": "string", "const": "bounded-real-repository-code-change" },
    "runtime": { "type": "string", "const": "codex" },
    "run_id": {
      "type": "string",
      "enum": [
        "s15e-provider-registry",
        "s15f-patch-proposal"
      ]
    },
    "approved_repository_write_set": { "type": "array", "items": { "type": "string" } },
    "repository_target_files": { "type": "array", "items": { "type": "string" } },
    "test_command": { "type": "array", "items": { "type": "string" } },
    "patch_proposal_required": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "task_id": { "const": "s15f-patch-proposal-repo-task" } } },
      "then": {
        "properties": {
          "milestone_name": { "const": "V5-S15F-PAI-RUNTIME-PATCH-PROPOSAL-APPLIER" },
          "run_id": { "const": "s15f-patch-proposal" },
          "patch_proposal_required": { "const": true }
        }
      }
    }
  ]
}
