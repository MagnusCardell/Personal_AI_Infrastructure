{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI State Proposal Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "source_proposal_run_id",
    "decision_authority",
    "decision_mode",
    "memory_decisions",
    "isa_decisions",
    "commit_authority_granted",
    "commit_performed",
    "memory_files_modified",
    "isa_files_modified",
    "pulse_files_modified",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S16B-PAI-STATE-PROPOSAL-REVIEW-POLICY" },
    "run_id": { "type": "string", "const": "s16b-proposal-review" },
    "source_proposal_run_id": { "type": "string", "const": "s16a-state-proposal" },
    "decision_authority": { "type": "string", "const": "pai-policy" },
    "decision_mode": { "type": "string", "const": "review-only" },
    "memory_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_item" }
    },
    "isa_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision_item" }
    },
    "commit_authority_granted": { "type": "boolean", "const": false },
    "commit_performed": { "type": "boolean", "const": false },
    "memory_files_modified": { "type": "boolean", "const": false },
    "isa_files_modified": { "type": "boolean", "const": false },
    "pulse_files_modified": { "type": "boolean", "const": false },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "decision_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposal_id",
        "decision",
        "rationale",
        "commit_status"
      ],
      "properties": {
        "proposal_id": { "type": "string" },
        "decision": {
          "type": "string",
          "enum": [
            "approved_for_future_commit_candidate",
            "rejected",
            "deferred",
            "needs_revision"
          ]
        },
        "rationale": { "type": "string" },
        "commit_status": { "type": "string", "const": "not_committed" }
      }
    }
  }
}
