{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Codex Beta Readiness Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "runtime",
    "runtime_attempt_number",
    "pai_runtime_command",
    "provider_commands_run",
    "evidence_artifacts_checked",
    "evidence_artifacts_missing",
    "evidence_artifacts_regenerated",
    "provider_registry_passed",
    "provider_lifecycle_passed",
    "capability_policy_passed",
    "patch_proposal_policy_passed",
    "readonly_pai_context_policy_passed",
    "event_logs_present",
    "event_attribution_passed",
    "approved_pai_run_writes",
    "ambient_pai_state_churn",
    "forbidden_semantic_writes",
    "unknown_unclassified_writes",
    "memory_write_performed_by_codex",
    "isa_write_performed_by_codex",
    "memory_body_read_by_codex",
    "isa_body_read_by_codex",
    "pulse_event_payload_read_by_codex",
    "pulse_probe_performed_by_codex",
    "localhost_31337_called_by_codex",
    "repo_root_agents_created",
    "repo_dotcodex_created",
    "codex_adapter_files_installed_under_home_codex",
    "replacement_readiness_claimed",
    "claude_equivalence_claimed",
    "validation_passed",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S15J-PAI-RUNTIME-CODEX-BETA-READINESS-GATE" },
    "run_id": { "type": "string", "const": "s15j-codex-beta-readiness" },
    "runtime": { "type": "string", "const": "codex" },
    "runtime_attempt_number": { "type": "integer", "minimum": 1 },
    "pai_runtime_command": { "type": "array", "minItems": 8, "items": { "type": "string" } },
    "provider_commands_run": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "evidence_artifacts_checked": { "type": "array", "items": { "type": "object" } },
    "evidence_artifacts_missing": { "type": "array", "items": { "type": "object" } },
    "evidence_artifacts_regenerated": { "type": "array", "items": { "type": "object" } },
    "provider_registry_passed": { "type": "boolean", "const": true },
    "provider_lifecycle_passed": { "type": "boolean", "const": true },
    "capability_policy_passed": { "type": "boolean", "const": true },
    "patch_proposal_policy_passed": { "type": "boolean", "const": true },
    "readonly_pai_context_policy_passed": { "type": "boolean", "const": true },
    "event_logs_present": { "type": "boolean", "const": true },
    "event_attribution_passed": { "type": "boolean", "const": true },
    "approved_pai_run_writes": { "type": "array", "minItems": 4, "items": { "type": "string" } },
    "ambient_pai_state_churn": { "type": "array", "items": { "type": "string" } },
    "forbidden_semantic_writes": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
    "unknown_unclassified_writes": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
    "memory_write_performed_by_codex": { "type": "boolean", "const": false },
    "isa_write_performed_by_codex": { "type": "boolean", "const": false },
    "memory_body_read_by_codex": { "type": "boolean", "const": false },
    "isa_body_read_by_codex": { "type": "boolean", "const": false },
    "pulse_event_payload_read_by_codex": { "type": "boolean", "const": false },
    "pulse_probe_performed_by_codex": { "type": "boolean", "const": false },
    "localhost_31337_called_by_codex": { "type": "boolean", "const": false },
    "repo_root_agents_created": { "type": "boolean", "const": false },
    "repo_dotcodex_created": { "type": "boolean", "const": false },
    "codex_adapter_files_installed_under_home_codex": { "type": "boolean", "const": false },
    "replacement_readiness_claimed": { "type": "boolean", "const": false },
    "claude_equivalence_claimed": { "type": "boolean", "const": false },
    "validation_passed": { "type": "boolean", "const": true },
    "known_limits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
