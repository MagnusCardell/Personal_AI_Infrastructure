{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PAI Shadow Commit Validation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "runtime",
    "runtime_attempt_number",
    "pai_runtime_command",
    "provider_command",
    "source_dry_run_plan_present",
    "source_dry_run_plan_schema_valid",
    "human_gate_present",
    "human_gate_valid",
    "shadow_context_capsule_present",
    "shadow_context_capsule_metadata_only",
    "policy_review_present",
    "policy_review_schema_valid",
    "selected_candidate_present",
    "selected_candidate_schema_valid",
    "selected_candidate_count",
    "single_candidate_selected",
    "selected_target_path_relative",
    "selected_target_path_allowed",
    "shadow_apply_result_present",
    "shadow_apply_result_schema_valid",
    "shadow_target_written",
    "shadow_target_under_run_dir",
    "shadow_content_hash_recorded",
    "commit_authority_granted",
    "commit_performed",
    "memory_files_modified",
    "isa_files_modified",
    "pulse_files_modified",
    "event_logs_present",
    "event_attribution_passed",
    "codex_file_change_events",
    "codex_command_execution_events",
    "approved_pai_run_writes",
    "ambient_pai_state_churn",
    "forbidden_semantic_writes",
    "unknown_unclassified_writes",
    "memory_body_read_by_codex",
    "isa_body_read_by_codex",
    "pulse_event_payload_read_by_codex",
    "memory_write_performed_by_codex",
    "isa_write_performed_by_codex",
    "pulse_probe_performed_by_codex",
    "localhost_31337_called_by_codex",
    "repo_root_agents_created",
    "repo_dotcodex_created",
    "codex_adapter_files_installed_under_home_codex",
    "validation_passed",
    "known_limits"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S16D-PAI-STATE-SINGLE-PROPOSAL-SHADOW-COMMIT" },
    "run_id": { "type": "string", "const": "s16d-single-proposal-shadow-commit" },
    "runtime": { "type": "string", "const": "codex" },
    "runtime_attempt_number": { "type": "integer", "minimum": 1 },
    "pai_runtime_command": { "type": "array", "items": { "type": "string" } },
    "provider_command": { "type": "array", "items": { "type": "string" } },
    "source_dry_run_plan_present": { "type": "boolean", "const": true },
    "source_dry_run_plan_schema_valid": { "type": "boolean", "const": true },
    "human_gate_present": { "type": "boolean", "const": true },
    "human_gate_valid": { "type": "boolean", "const": true },
    "shadow_context_capsule_present": { "type": "boolean", "const": true },
    "shadow_context_capsule_metadata_only": { "type": "boolean", "const": true },
    "policy_review_present": { "type": "boolean", "const": true },
    "policy_review_schema_valid": { "type": "boolean", "const": true },
    "selected_candidate_present": { "type": "boolean", "const": true },
    "selected_candidate_schema_valid": { "type": "boolean", "const": true },
    "selected_candidate_count": { "type": "integer", "const": 1 },
    "single_candidate_selected": { "type": "boolean", "const": true },
    "selected_target_path_relative": { "type": "boolean", "const": true },
    "selected_target_path_allowed": { "type": "boolean", "const": true },
    "shadow_apply_result_present": { "type": "boolean", "const": true },
    "shadow_apply_result_schema_valid": { "type": "boolean", "const": true },
    "shadow_target_written": { "type": "boolean", "const": true },
    "shadow_target_under_run_dir": { "type": "boolean", "const": true },
    "shadow_content_hash_recorded": { "type": "boolean", "const": true },
    "commit_authority_granted": { "type": "boolean", "const": false },
    "commit_performed": { "type": "boolean", "const": false },
    "memory_files_modified": { "type": "boolean", "const": false },
    "isa_files_modified": { "type": "boolean", "const": false },
    "pulse_files_modified": { "type": "boolean", "const": false },
    "event_logs_present": { "type": "boolean", "const": true },
    "event_attribution_passed": { "type": "boolean", "const": true },
    "codex_file_change_events": { "type": "array", "items": { "type": "object" } },
    "codex_command_execution_events": { "type": "array", "items": { "type": "object" } },
    "approved_pai_run_writes": { "type": "array", "items": { "type": "string" } },
    "ambient_pai_state_churn": { "type": "array", "items": { "type": "string" } },
    "forbidden_semantic_writes": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
    "unknown_unclassified_writes": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
    "memory_body_read_by_codex": { "type": "boolean", "const": false },
    "isa_body_read_by_codex": { "type": "boolean", "const": false },
    "pulse_event_payload_read_by_codex": { "type": "boolean", "const": false },
    "memory_write_performed_by_codex": { "type": "boolean", "const": false },
    "isa_write_performed_by_codex": { "type": "boolean", "const": false },
    "pulse_probe_performed_by_codex": { "type": "boolean", "const": false },
    "localhost_31337_called_by_codex": { "type": "boolean", "const": false },
    "repo_root_agents_created": { "type": "boolean", "const": false },
    "repo_dotcodex_created": { "type": "boolean", "const": false },
    "codex_adapter_files_installed_under_home_codex": { "type": "boolean", "const": false },
    "validation_passed": { "type": "boolean", "const": true },
    "known_limits": { "type": "array", "items": { "type": "string" } }
  }
}
