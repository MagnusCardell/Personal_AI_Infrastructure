{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "S15E PAI Runtime Repository Run Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "milestone_name",
    "run_id",
    "runtime",
    "runtime_status",
    "provider_type",
    "pai_dir",
    "repo_root",
    "task_id",
    "task_kind",
    "adapter_identity_marker",
    "adapter_status",
    "upstream_adapter",
    "agents_router_observed",
    "pai_owned_run_directory",
    "repository_files_modified",
    "tests_run",
    "tests_passed",
    "memory_write_performed",
    "isa_write_performed",
    "pulse_probe_performed",
    "localhost_31337_called",
    "runtime_surface_created",
    "result_summary",
    "evidence_classification",
    "known_limits",
    "provider_registry_file_content",
    "provider_registry_test_file_content"
  ],
  "properties": {
    "milestone_name": { "type": "string", "const": "V5-S15E-PAI-RUNTIME-CODEX-REAL-REPO-TASK" },
    "run_id": { "type": "string", "const": "s15e-provider-registry" },
    "runtime": { "type": "string", "const": "codex" },
    "runtime_status": { "type": "string", "const": "peer-beta" },
    "provider_type": { "type": "string", "const": "codex-cli" },
    "pai_dir": { "type": "string" },
    "repo_root": { "type": "string" },
    "task_id": { "type": "string", "const": "s15e-provider-registry-repo-task" },
    "task_kind": { "type": "string", "const": "bounded-real-repository-code-change" },
    "adapter_identity_marker": { "type": "string", "const": "PAI_CODEX_PEER_BETA_ADAPTER" },
    "adapter_status": { "type": "string", "const": "peer-beta" },
    "upstream_adapter": { "type": "string", "const": "claude" },
    "agents_router_observed": { "type": "boolean" },
    "pai_owned_run_directory": { "type": "boolean" },
    "repository_files_modified": { "type": "array", "items": { "type": "string" } },
    "tests_run": { "type": "array", "items": { "type": "string" } },
    "tests_passed": { "type": "boolean" },
    "memory_write_performed": { "type": "boolean" },
    "isa_write_performed": { "type": "boolean" },
    "pulse_probe_performed": { "type": "boolean" },
    "localhost_31337_called": { "type": "boolean" },
    "runtime_surface_created": { "type": "boolean" },
    "result_summary": { "type": "string" },
    "evidence_classification": { "type": "array", "items": { "type": "string" } },
    "known_limits": { "type": "array", "items": { "type": "string" } },
    "provider_registry_file_content": { "type": "string" },
    "provider_registry_test_file_content": { "type": "string" }
  }
}
